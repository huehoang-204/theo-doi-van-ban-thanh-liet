# ===== CSDL =====
# Dev trên máy A30: PostgreSQL 14 userspace (scripts/dev/local-postgres.sh), cổng 5452.
# Máy có Docker: `docker compose up -d db` (postgres 16) — đặt DEV_PG_PORT/POSTGRES_* tương ứng.
DATABASE_URL="postgresql://webtl:doi_mat_khau_nay@127.0.0.1:5452/webtl?schema=public"

# Chỉ dùng cho scripts/dev/local-postgres.sh (thư mục data phải nằm NGOÀI repo)
DEV_PG_DATA_DIR="/hdd3/huehp/.local/webtl-postgres"
DEV_PG_PORT=5452
# DEV_PG_BIN_DIR="/usr/lib/postgresql/14/bin"

# Chỉ dùng cho docker-compose.yml
POSTGRES_DB=webtl
POSTGRES_USER=webtl
POSTGRES_PASSWORD=doi_mat_khau_nay

# ===== Ứng dụng =====
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET="thay_bang_chuoi_ngau_nhien"
# false khi chạy http trong mạng LAN lúc dev; production (HTTPS) phải là true
COOKIE_SECURE=false

# 1 = chạy lịch job (nhắc hạn 06:30, job đêm 00:15) ngay trong tiến trình web thay cho `npm run worker`
# (dùng trên Render). Dev: để trống và chạy `npm run worker` riêng — KHÔNG bật cả hai.
# WORKER_INLINE=1

# Thư mục lưu tệp tải lên (ngoài repo, không phục vụ trực tiếp)
UPLOAD_DIR="/hdd3/huehp/.local/webtl-uploads"

# ===== Seed =====
# SEED_ADMIN_PASSWORD="mat_khau_admin_ban_dau"
# SEED_SAMPLE=0                      # 0 = không nạp dữ liệu mẫu
# SEED_SAMPLE_PASSWORD="..."         # mật khẩu tài khoản mẫu (mặc định ThanhLiet@2026)

# ===== Kiểm thử =====
# Nơi lưu trình duyệt Playwright (máy A30: để ngoài $HOME vì quota 20GB)
PLAYWRIGHT_BROWSERS_PATH="/hdd3/huehp/.cache/ms-playwright"
